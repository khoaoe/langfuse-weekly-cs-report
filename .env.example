# Langfuse read-only dashboard source
LANGFUSE_SECRET_KEY=replace-with-langfuse-secret-key
LANGFUSE_PUBLIC_KEY=replace-with-langfuse-public-key
LANGFUSE_BASE_URL=https://langfuse.zalopay.vn

# Production auth boundary (see README section 9). "proxy" for real production
# behind an SSO-terminating reverse proxy; "basic" only for a platform (e.g.
# Zalopay Agent Base) that enforces its own HTTP Basic Auth at the edge.
DASHBOARD_AUTH_MODE=proxy

# Only set this when the deploy platform can reach LANGFUSE_BASE_URL's host
# over TCP but has no DNS route to it (e.g. an internal-only name on a shared
# PaaS). Format host:ip. Leave unset on real production networking.
# LANGFUSE_DNS_OVERRIDE=langfuse.zalopay.vn:10.30.94.60

# Freshdesk CSAT discovery/fetch only
# Not required by dashboard serving, Langfuse reporting, or verify-dimensions.
FRESHDESK_BASE_URL=https://vngzalopay.freshdesk.com
FRESHDESK_API_KEY=replace-with-freshdesk-api-key

# Optional label route
LABEL_API_KEY=replace-with-label-api-key
LABEL_BASE_URL=https://replace-with-label-host
LABEL_MODEL=replace-with-label-model

# Optional embedding route
EMBED_BASE_URL=https://replace-with-embedding-host
EMBED_MODEL=replace-with-embedding-model
EMBED_API_KEY=replace-with-embedding-api-key

# CS-agent skill discovery
# Set enabled=true only after TOKEN and CAS_COOKIE contain real current values.
CS_AGENT_ENABLED=false
CS_AGENT_BASE_URL=https://cs-agent.zalopay.vn
CS_AGENT_TOKEN=replace-with-raw-jwt-without-Bearer-prefix
CS_AGENT_CAS_COOKIE='replace-with-full-Cookie-header-value-without-Cookie-prefix'
